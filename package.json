{
  "name": "jsclaw",
  "version": "0.0.14",
  "description": "Lightweight container orchestration for Claude AI agents. Pure JavaScript ESM.",
  "type": "module",
  "license": "AGPL-3.0-or-later",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "src/",
    "container/",
    "bin/",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "jsclaw": "./bin/jsclaw.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./config": "./src/config.js",
    "./container-runner": "./src/container-runner.js",
    "./ipc": "./src/ipc.js",
    "./ipc-utils": "./src/ipc-utils.js",
    "./group-queue": "./src/group-queue.js",
    "./cron": "./src/cron.js",
    "./task-store": "./src/task-store.js",
    "./task-scheduler": "./src/task-scheduler.js",
    "./heartbeat": "./src/heartbeat.js",
    "./channel": "./src/channel.js",
    "./gateway": "./src/gateway.js",
    "./ws": "./src/ws.js",
    "./nostr": "./src/nostr.js",
    "./providers": "./src/providers.js",
    "./webhooks": "./src/webhooks.js",
    "./memory": "./src/memory.js",
    "./skills": "./src/skills.js",
    "./bindings": "./src/bindings.js",
    "./mount-security": "./src/mount-security.js",
    "./types": "./src/types.js",
    "./container/agent-runner": "./container/agent-runner.js",
    "./container/mcp-server": "./container/mcp-server.js"
  },
  "main": "./src/index.js",
  "scripts": {
    "test": "node --test test/*.test.js",
    "test:e2e": "node --test test/e2e.test.js",
    "lint": "node --check src/*.js bin/jsclaw.js container/agent-runner.js container/mcp-server.js",
    "docker:build": "docker build -t jsclaw-agent:latest -f container/Dockerfile container/"
  },
  "keywords": [
    "claude",
    "ai",
    "agent",
    "container",
    "docker",
    "mcp",
    "orchestration",
    "nostr"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/jsclaw/jsclaw"
  },
  "homepage": "https://github.com/jsclaw/jsclaw",
  "bugs": {
    "url": "https://github.com/jsclaw/jsclaw/issues"
  },
  "dependencies": {
    "grammy": "^1.43.0"
  }
}
