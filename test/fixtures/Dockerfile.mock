# Mock agent image for E2E tests — speaks jsclaw's container protocol
# with no Claude SDK and no API key. Builds in seconds.
FROM node:22-slim

RUN mkdir -p /workspace/group /workspace/ipc/messages /workspace/ipc/tasks /workspace/ipc/input /app

COPY mock-agent.js /app/mock-agent.js

WORKDIR /workspace/group

ENTRYPOINT ["node", "/app/mock-agent.js"]
